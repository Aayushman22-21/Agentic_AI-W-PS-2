# AI Career Coach Environment Variables
PORT=4000

# GitHub Personal Access Token (optional, increases GitHub API rate limits from 60 to 5000 req/hr)
GITHUB_TOKEN=

# GitHub Webhook HMAC Secret (used to verify X-Hub-Signature-256 for push webhooks)
GITHUB_WEBHOOK_SECRET=your-secure-webhook-secret-here

# Supabase PostgreSQL Configuration (optional for remote Supabase instance; falls back to embedded durable JSON store)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
